<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Menu bar utility: no Dock icon, no app-switcher entry. -->
    <key>LSUIElement</key>
    <true/>

    <!-- No encryption beyond what macOS itself provides. Without this key the
         App Store asks the export-compliance question on every upload. -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>

    <!-- Required by App Store validation (error 90242); a build without it is
         rejected before it ever reaches review. Set here as well as via
         `bundle.category` in tauri.conf.json so the value cannot go missing
         if the generated plist changes. -->
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.productivity</string>
</dict>
</plist>
