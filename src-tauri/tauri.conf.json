{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TimeBox",
  "version": "0.2.0",
  "identifier": "xyz.gigiheristiawan.timebox",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TimeBox",
        "width": 620,
        "height": 640,
        "minWidth": 460,
        "minHeight": 480,
        "resizable": true,
        "visible": true,
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "category": "Productivity",
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
